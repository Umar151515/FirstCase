# Local demo. Production settings are documented in README.md.
APP_MODE=demo
DEBUG=true
POSTGRES_PASSWORD=firstcase_demo_local
TEST_POSTGRES_PASSWORD=firstcase_test_local
POSTGRES_PORT=5543
TEST_POSTGRES_PORT=5544
API_PORT=8000
WEB_PORT=8080

# These host URLs are for uv commands; Compose supplies its internal hostnames.
DATABASE_URL=postgresql+asyncpg://firstcase:firstcase_demo_local@localhost:5543/firstcase_demo
TEST_DATABASE_URL=postgresql+asyncpg://firstcase_test:firstcase_test_local@localhost:5544/firstcase_test
JWT_SECRET=firstcase-local-demo-secret-change-in-production-4d924ef7
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=
PUBLIC_WEBAPP_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8000
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
